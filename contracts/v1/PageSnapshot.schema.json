{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/PageSnapshot.schema.json",
  "title": "PageSnapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "final_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "HTTP",
        "BROWSER",
        "SYNTHETIC"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "private_object_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "FETCHED",
        "ACCESS_BLOCKED",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "snapshot_id",
    "run_id",
    "policy_id",
    "policy_version",
    "url",
    "final_url",
    "captured_at",
    "capture_mode",
    "sha256",
    "private_object_ref",
    "status"
  ],
  "additionalProperties": false
}
