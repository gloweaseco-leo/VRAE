{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/collection/FetchResponse.schema.json",
  "title": "FetchResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "peer_ip": {
      "type": "string",
      "maxLength": 64
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1500000
    },
    "content_type": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "null"
        }
      ]
    },
    "measurement": {
      "type": "object",
      "properties": {
        "connect_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "stream_setup_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "first_byte_after_send_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "headers_after_send_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "body_after_headers_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "exchange_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "method": {
          "const": "PINNED_HTTP_MONOTONIC_V1"
        },
        "scope": {
          "const": "FINAL_HOP_INCLUDES_GUARD_AND_SCHEDULING_NO_DNS"
        },
        "samples": {
          "const": 1
        }
      },
      "required": [
        "connect_ms",
        "stream_setup_ms",
        "first_byte_after_send_ms",
        "headers_after_send_ms",
        "body_after_headers_ms",
        "exchange_ms",
        "method",
        "scope",
        "samples"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "url",
    "status",
    "peer_ip",
    "body_sha256",
    "body_bytes",
    "content_type"
  ],
  "additionalProperties": false
}
