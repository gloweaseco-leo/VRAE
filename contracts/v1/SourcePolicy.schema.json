{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/SourcePolicy.schema.json",
  "title": "SourcePolicy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "PUBLIC_READONLY_RESEARCH",
        "OWNER_AUTHORIZED_DEEP"
      ]
    },
    "permitted_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "maxItems": 256,
      "minItems": 1
    },
    "scope_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "uniqueItems": true,
      "maxItems": 256,
      "minItems": 1
    },
    "authorization_reference": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "policy_id",
    "policy_version",
    "mode",
    "permitted_hosts",
    "scope_paths",
    "authorization_reference",
    "expires_at",
    "revoked_at",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "OWNER_AUTHORIZED_DEEP"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "authorization_reference": {
            "not": {
              "type": "null"
            }
          },
          "expires_at": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
