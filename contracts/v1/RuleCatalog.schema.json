{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/RuleCatalog.schema.json",
  "title": "RuleCatalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "DISC-01",
              "DISC-02",
              "DISC-03",
              "INFO-01",
              "INFO-02",
              "INFO-03",
              "TRUST-01",
              "TRUST-02",
              "TRUST-03",
              "CTA-01",
              "CTA-02",
              "CTA-03",
              "SEO-01",
              "SEO-02",
              "TECH-01",
              "TECH-02"
            ]
          },
          "rule_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "buyer_task": {
            "type": "string",
            "enum": [
              "DISCOVER",
              "UNDERSTAND",
              "TRUST",
              "INQUIRE",
              "SEARCH_TECHNICAL"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "false_positive_risks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "synthetic_expectations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "positive": {
                "const": "PASS"
              },
              "counterexample": {
                "const": "FAIL_WITH_EVIDENCE"
              },
              "no_evidence": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "positive",
              "counterexample",
              "no_evidence"
            ]
          }
        },
        "required": [
          "rule_id",
          "rule_version",
          "buyer_task",
          "method",
          "applicability",
          "evidence_requirements",
          "false_positive_risks",
          "synthetic_expectations"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "rules"
  ]
}
