{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/collection/FetchResponse.schema.json",
  "title": "FetchResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "peer_ip": {
      "type": "string",
      "maxLength": 64
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1500000
    },
    "content_type": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "url",
    "status",
    "peer_ip",
    "body_sha256",
    "body_bytes",
    "content_type"
  ],
  "additionalProperties": false
}
