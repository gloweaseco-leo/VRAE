{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/collection/extensions/MetadataCitation.schema.json",
  "title": "MetadataCitation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "http_status", "redirects", "bytes", "first_byte_ms", "exchange_ms", "note"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "METADATA_CITATION"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "redirects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {"status": {"type": "integer", "minimum": 300, "maximum": 399}}
      }
    },
    "bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 2000000},
    "first_byte_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 600000},
    "exchange_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 600000},
    "note": {
      "const": "单次测量，含调度开销，不含 DNS。不是用户体验，也不是评分。渲染性能与移动端本次未测。"
    }
  }
}
