{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/AIInterpretation.schema.json",
  "title": "AIInterpretation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "interpretation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "REJECTED",
        "NOT_RUN"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "interpretation_id",
    "run_id",
    "observation_ids",
    "evidence_ids",
    "hypotheses",
    "recommendations",
    "missing_information",
    "model_id",
    "input_tokens",
    "output_tokens",
    "status"
  ],
  "additionalProperties": false
}
