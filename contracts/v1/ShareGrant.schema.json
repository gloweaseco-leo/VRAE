{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/ShareGrant.schema.json",
  "title": "ShareGrant",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "report_version_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "token_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "grant_id",
    "report_version_id",
    "content_hash",
    "subject_ref",
    "token_hash",
    "status",
    "issued_at",
    "expires_at",
    "revoked_at"
  ],
  "additionalProperties": false
}
