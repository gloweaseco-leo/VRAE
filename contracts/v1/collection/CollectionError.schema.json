{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/collection/CollectionError.schema.json",
  "title": "CollectionError",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "code": {
      "enum": [
        "ACCESS_BLOCKED",
        "CANCELLED",
        "CONTENT_ENCODING_INVALID",
        "CONTENT_TYPE_INVALID",
        "DNS_FAILED",
        "EVIDENCE_INSUFFICIENT",
        "EVIDENCE_INTEGRITY",
        "FORBIDDEN_TENANT",
        "HOST_BUSY",
        "HTTP_ERROR",
        "HTTP_PROTOCOL_ERROR",
        "INPUT_INVALID",
        "INVALID_URL",
        "LIMIT_EXCEEDED",
        "METHOD_NOT_ALLOWED",
        "NETWORK_ERROR",
        "POLICY_EXPIRED",
        "POLICY_REQUIRED",
        "POLICY_REVOKED",
        "REDIRECT_BLOCKED",
        "REDIRECT_LIMIT",
        "ROBOTS_DISALLOWED",
        "ROBOTS_UNKNOWN",
        "SOURCE_NOT_ALLOWED",
        "SSRF_BLOCKED",
        "TIMEOUT",
        "TLS_FAILED"
      ]
    },
    "safe_message": {
      "type": "string",
      "maxLength": 100
    },
    "retryable": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "code",
    "safe_message",
    "retryable"
  ],
  "additionalProperties": false
}
