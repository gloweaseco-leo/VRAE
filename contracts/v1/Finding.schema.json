{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/Finding.schema.json",
  "title": "Finding",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "HYPOTHESIS",
        "RECOMMENDATION",
        "UNKNOWN"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "buyer_task": {
      "type": "string",
      "enum": [
        "DISCOVER",
        "UNDERSTAND",
        "TRUST",
        "INQUIRE",
        "SEARCH_TECHNICAL"
      ]
    },
    "severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "finding_id",
    "run_id",
    "observation_id",
    "kind",
    "evidence_ids",
    "statement",
    "buyer_task",
    "severity",
    "rule_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "OBSERVATION"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
