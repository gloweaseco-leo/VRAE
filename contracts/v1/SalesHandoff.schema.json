{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/SalesHandoff.schema.json",
  "title": "SalesHandoff",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "report_version_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "source_system": {
      "const": "vrae"
    },
    "stage": {
      "type": "string",
      "enum": [
        "HANDOFF_REQUESTED",
        "VF_INQUIRY_RECORDED",
        "QUALIFIED_BY_HUMAN"
      ]
    },
    "vf_receipt_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inquiry_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "handoff_id",
    "audit_id",
    "report_version_id",
    "source_system",
    "stage",
    "vf_receipt_ref",
    "inquiry_evidence_ref",
    "verified_by",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "VF_INQUIRY_RECORDED"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "vf_receipt_ref": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "QUALIFIED_BY_HUMAN"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "vf_receipt_ref": {
            "not": {
              "type": "null"
            }
          },
          "inquiry_evidence_ref": {
            "not": {
              "type": "null"
            }
          },
          "verified_by": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
