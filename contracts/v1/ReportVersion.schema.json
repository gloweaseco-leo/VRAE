{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrae.invalid/contracts/v1/ReportVersion.schema.json",
  "title": "ReportVersion",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "report_version_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of canonical RA-0 report manifest plus resolved finding records; see report_content_hash. Not a proof of factual truth."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "created_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_mode": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "report_id",
    "report_version_id",
    "run_id",
    "version",
    "content_hash",
    "status",
    "finding_ids",
    "created_by",
    "created_at",
    "approved_by",
    "approved_at",
    "audit_mode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "not": {
              "type": "null"
            }
          },
          "approved_at": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "finding_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
